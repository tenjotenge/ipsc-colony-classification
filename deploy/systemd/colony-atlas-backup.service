[Unit]
Description=Back up Colony Atlas data

[Service]
Type=oneshot
User=colony-atlas
Group=colony-atlas
EnvironmentFile=/etc/colony-atlas/backup.env
ExecStart=/opt/colony-atlas/linux-v1/run.sh backup scheduled --data-dir ${ATLAS_DATA_DIR} --backup-dir ${ATLAS_BACKUP_DIR}
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/colony-atlas
PrivateTmp=true
